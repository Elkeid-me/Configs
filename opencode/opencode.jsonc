{
  "$schema": "https://opencode.ai/config.json",
  // "shell": "bash", // for Linux and MacOS
  "shell": "C:\\Program Files\\Git\\bin\\bash.exe", // for Windows
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cd *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    }
  ],
  "agents": {
    "title": {
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "explore": {
      "model": "deepseek/deepseek-flash#high"
    }
  },
  "plugins": [
    "opencode-windows-encoding"
  ]
}