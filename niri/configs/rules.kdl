window-rule {
    match app-id="ghostty"
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="rofi"
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 12
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}